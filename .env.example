# ==============================================================================
# ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the values. Do not commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# APP & SERVER
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
THROTTLE_LIMIT=100
AUTH_LOGIN_THROTTLE_LIMIT=5

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=dev
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=gdgoc
DATABASE_URL="postgresql://dev:devpassword@127.0.0.1:5432/gdgoc?schema=public"
TEST_DATABASE_URL="postgresql://dev:devpassword@127.0.0.1:5432/gdgoc_test?schema=public"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# JWT Secret (Must be at least 32 characters long in production, non-placeholder)
JWT_SECRET="generate-a-strong-secret-key-for-jwt-minimum-32-chars"
